      m_Calls: []
  m_text: "\uC815\uCCB4\uBD88\uBA85\uC758 \uC880\uBE44 \uBC14\uC774\uB7EC\uC2A4\uAC00
    \uBD80\uC0B0\uD589 \uC5F4\uCC28 \uB0B4\uBD80\uC5D0\uC11C \uAE09\uC18D\uB3C4\uB85C
    \uD655\uC0B0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC5F4\uCC28\uB294 \uAE34\uAE09
    \uC0C1\uD669\uC73C\uB85C \uC911\uAC04 \uC815\uCC28\uAC00 \uBD88\uAC00\uB2A5\uD558\uBA70,
    \uC720\uC77C\uD55C \uC548\uC804\uC9C0\uB300\uC778 \uAE30\uC7A5\uC2E4\uC740 \uC644\uC804\uD788
    \uC7A0\uAE34 \uC0C1\uD0DC\uC785\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC740 \uAE30\uC7A5\uC2E4\uC5D0\uC11C
    \uAC00\uC7A5 \uBA3C \uAC1D\uCC28\uC5D0\uC11C \uD63C\uC790 \uC0B4\uC544\uB0A8\uC558\uC2B5\uB2C8\uB2E4.\n\uC8FC\uBCC0
    \uAC1D\uCC28\uB294 \uC774\uBBF8 \uAC10\uC5FC\uB41C \uC2B9\uAC1D\uB4E4\uB85C \uAC00\uB4DD
    \uCC28 \uC788\uC73C\uBA70, \uC810\uC810 \uB354 \uB9CE\uC740 \uC880\uBE44\uB4E4\uC774
    \uB2F9\uC2E0\uC744 \uD5A5\uD574 \uB2E4\uAC00\uC624\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uBAA9\uD45C\uB294
    \uB2E8 \uD558\uB098\u2014\n\uC880\uBE44\uAC00 \uB418\uC9C0 \uC54A\uC740 \uCC44
    \uAE30\uC7A5\uC2E4\uAE4C\uC9C0 \uB3C4\uB2EC\uD558\uC5EC \uCD5C\uD6C4\uC758 \uC0DD\uC874\uC790\uB85C
    \uBD80\uC0B0\uC5D0 \uB3C4\uCC29\uD558\uB294 \uAC83.\n\n\uC900\uBE44\uB418\uC5C8\uB2E4\uBA74,
    \uC880\uBE44\uB97C \uC8FD\uC5EC \uC55E\uC73C\uB85C \uB098\uC544\uAC00\uC2ED\uC2DC\uC624.\n\uC0DD\uC874\uC740
    \uC624\uC9C1 \uB2F9\uC2E0\uC758 \uC120\uD0DD\uC5D0 \uB2EC\uB824 \uC788\uC2B5\uB2C8\uB2E4."
