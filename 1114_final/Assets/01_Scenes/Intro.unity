  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC774 \uC5F4\uCC28\uC758 \uC880\uBE44\uB4E4\uC740 \uD3C9\uC18C\uC5D0\uB294
    \uC758\uC790 \uC544\uB798\uC5D0 \uC228\uC5B4 \uAE30\uC808\uD55C \uB4EF \n\uC6C0\uC9C1\uC784\uC774
    \uAC70\uC758 \uC5C6\uB294 \uC0C1\uD0DC\uB85C \uB300\uAE30\uD558\uACE0 \uC788\uC5B4
    \uD50C\uB808\uC774\uC5B4\uC758 \uC2DC\uC57C\uC5D0\uC11C\uB294 \uC798 \uBCF4\uC774\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uADF8\uB7EC\uB098, \uC880\uBE44\uB4E4\uC740 \uD6C4\uAC01\uACFC
    \uCCAD\uAC01\uC774 \uADF9\uB3C4\uB85C \uBC1C\uB2EC\uD574 \uC788\uC2B5\uB2C8\uB2E4.\n\uB530\uB77C\uC11C
    \uB2F9\uC2E0\uC774 \uB108\uBB34 \uAC00\uAE4C\uC774 \uC811\uADFC\uD558\uBA74,
    \uC880\uBE44\uB294 \uC989\uC2DC \uAE68\uC5B4\uB098 \uB2F9\uC2E0\uC744 \uD5A5\uD574
    \uB3CC\uC9C4\uD569\uB2C8\uB2E4.\n\n\uD50C\uB808\uC774\uC5B4 \uC774\uB3D9: \u2190
    \u2191 \u2192 \u2193\nQ: \uC67C\uCABD\uC73C\uB85C \uCD1D\uAD6C \uD68C\uC804 
    /  E: \uC624\uB978\uCABD\uC73C\uB85C \uCD1D\uAD6C \uD68C\uC804\nSpace bar: \uCD1D
    \uBC1C\uC0AC (\uC880\uBE44 \uCC98\uCE58 \uAC00\uB2A5)\n\uC624\uB978\uCABD \uCEE8\uD2B8\uB864\uB7EC
    B: Continue \uBC84\uD2BC\n\n\uC880\uBE44\uC640 \uB9E4\uC6B0 \uAC00\uAE4C\uC6CC\uC838
    \uC880\uBE44\uAC00 \uB2F9\uC2E0\uC744 \uBB3C\uBA74 \uBAA9\uC228\uC774 1\uAC1C
    \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\uBAA9\uC228 3\uAC1C\uAC00 \uBAA8\uB450 \uC18C\uC9C4\uB418\uBA74
    \uC989\uC2DC \uAC8C\uC784 \uC624\uBC84\uB429\uB2C8\uB2E4.\n\n\uC774\uC81C \uC900\uBE44\uAC00
    \uB418\uC5C8\uB2E4\uBA74 B \uBC84\uD2BC\uC744 \uB20C\uB7EC \uAC8C\uC784\uC744
    \uC2DC\uC791\uD558\uC138\uC694.\n\n\n"
  m_isRightToLeft: 0
